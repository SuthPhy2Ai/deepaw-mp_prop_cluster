{
  "experiment_id": "exp103",
  "experiment_name": "stageb_v3_core_guard",
  "description": "Stage B v3 to protect Stage A core tasks by further reducing elastic oversampling",
  "phase": 3,
  "model": {
    "backbone": "graph",
    "hidden_dim": 256,
    "layers": 6,
    "cutoff": 6.0,
    "max_neighbors": 24,
    "n_rbf": 64,
    "use_angles": false,
    "use_edge_update": false,
    "use_pyg": true
  },
  "training": {
    "split": "data/splits/split_iid_seed42.json",
    "stage": "b",
    "batch_size": 64,
    "num_workers": 4,
    "epochs": 50,
    "lr": 0.0001,
    "weight_decay": 1e-5,
    "grad_clip": 1.0,
    "warmup_epochs": 5,
    "oversample_elastic": 1.0,
    "ema_decay": 0.0
  },
  "v3_changes": [
    "oversample_elastic: 2.0 -> 1.0",
    "keep stage=b task set and PyG backend",
    "same optimizer/scheduler for fair isolation"
  ],
  "hypothesis": [
    "Further reduce gradient pull from sparse elastic labels",
    "Recover electronic/core task quality with acceptable elastic degradation"
  ]
}
