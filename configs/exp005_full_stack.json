{
  "experiment_id": "exp005",
  "experiment_name": "full_stack",
  "description": "Combined enhancements: architecture + regularization + stability",
  "phase": 2,

  "model": {
    "backbone": "enhanced_graph",
    "hidden_dim": 256,
    "layers": 6,
    "cutoff": 8.0,
    "max_neighbors": 48,
    "n_rbf": 128,
    "use_angles": true,
    "use_edge_update": true
  },

  "training": {
    "split": "data/splits/split_iid_seed42.json",
    "stage": "a",
    "batch_size": 64,
    "num_workers": 8,
    "epochs": 100,
    "lr": 0.0002,
    "weight_decay": 0.0001,
    "grad_clip": 5.0,
    "warmup_epochs": 5,
    "dropout": 0.1,
    "ema_decay": 0.999,
    "early_stopping_patience": 15
  },

  "data": {
    "exclude_tasks": ["volume", "density", "is_stable"]
  },

  "changes_from_baseline": [
    "Enhanced graph architecture (exp003)",
    "Angle features (exp004)",
    "Edge update mechanism",
    "Strong regularization (exp002): dropout + weight decay",
    "EMA with decay=0.999",
    "Early stopping patience=15"
  ],

  "expected_outcomes": [
    "Best overall performance",
    "Balanced train-val performance",
    "Val loss < 0.19",
    "All task MAE improvements > 10% vs baseline",
    "Train-val gap < 0.04",
    "Production-ready model"
  ]
}
