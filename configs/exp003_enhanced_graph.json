{
  "experiment_id": "exp003",
  "experiment_name": "enhanced_graph",
  "description": "Enhanced graph architecture with larger cutoff and more RBF basis",
  "phase": 2,

  "model": {
    "backbone": "enhanced_graph",
    "hidden_dim": 256,
    "layers": 6,
    "cutoff": 8.0,
    "max_neighbors": 48,
    "n_rbf": 128,
    "use_angles": false,
    "use_edge_update": false
  },

  "training": {
    "split": "data/splits/split_iid_seed42.json",
    "stage": "a",
    "batch_size": 64,
    "num_workers": 8,
    "epochs": 100,
    "lr": 0.0002,
    "weight_decay": 1e-5,
    "grad_clip": 5.0,
    "warmup_epochs": 5,
    "dropout": 0,
    "ema_decay": 0,
    "early_stopping_patience": 0
  },

  "data": {
    "exclude_tasks": ["volume", "density", "is_stable"]
  },

  "changes_from_baseline": [
    "Backbone: graph → enhanced_graph",
    "Cutoff: 6.0 → 8.0 Å (larger neighborhood)",
    "Max neighbors: 24 → 48",
    "RBF basis: 64 → 128",
    "Gradient clipping: 1.0 → 5.0 (allow larger gradients)"
  ],

  "expected_outcomes": [
    "Better long-range interaction capture",
    "Improved electronic property predictions",
    "efermi MAE < 0.35 eV",
    "cbm/vbm MAE < 0.25 eV",
    "Val loss < 0.21"
  ]
}
