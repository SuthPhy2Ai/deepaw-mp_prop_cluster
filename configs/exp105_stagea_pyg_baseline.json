{
  "experiment_id": "exp105",
  "experiment_name": "stagea_pyg_baseline",
  "description": "Stage A baseline retrain with PyG backend under isolated tracking and exact 8-task parity with 20260305_210307",
  "phase": 3,
  "base_reference_run": "20260305_210307",
  "model": {
    "backbone": "graph",
